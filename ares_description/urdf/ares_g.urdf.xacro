          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.105</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_middle_left_joint</left_joint>
      <left_joint>wheel_rear_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_middle_right_joint</right_joint>
      <right_joint>wheel_rear_right_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.105</wheel_radius>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <topic>cmd_vel</topic>
      <max_linear_velocity>1.111</max_linear_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
    </plugin>
  </gazebo>
</robot>
