// .devcontainer/devcontainer.json
//
// One definition, works on Mac and in Codespaces. Build spec section 06.2.
// The desktop-lite feature serves a browser desktop on port 6080, so RViz
// and Gazebo appear in a browser tab in both cases and you never fight
// XQuartz.
{
  "name": "ares-autonomy",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": { "password": "ares" },

    // Not in section 06.2, and needed. The osrf/ros images carry no SSH
    // server, so without this a Codespace built from them can only be
    // reached through the browser or VS Code. Section 06.4 wants this
    // environment used for the automated gates, and a gate you cannot drive
    // from a terminal is not automated. Codespaces falls back to a recovery
    // container when it cannot open a shell, which looks like a build
    // failure and is not one.
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "forwardPorts": [6080],
  "portsAttributes": { "6080": { "label": "desktop" } },
  "containerEnv": {
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "DISPLAY": ":1",
    "ROS_DOMAIN_ID": "42"
  },
  "postCreateCommand": "pip install -e ./ares_math && colcon build --symlink-install",

  // Section 06.4 asks for 8 or 16 cores, because software rendered Gazebo is
  // CPU bound. This account's Codespaces plan offers 2 and 4 core machines
  // only, and asking for 8 returns an empty machine list rather than a
  // smaller machine, so nothing starts at all.
  //
  // 4 is therefore the floor that is actually obtainable. This is a
  // compromise, not a correction to the spec. What it costs:
  //
  //   - run the simulation headless, gz sim -s, and view through RViz. The
  //     Gazebo GUI on four software rendered cores is not worth the cycles.
  //   - keep simulated camera resolution at 640 by 360, as section 06.2 says.
  //   - expect a real time factor below 1. Every gate in section 10 is a
  //     geometric or logical assertion rather than a timing one, so a slow
  //     simulation still answers them. Anything that becomes a latency claim
  //     needs real compute, not this.
  //
  // Raise this back to 8 as soon as a larger machine is available.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" }
}
